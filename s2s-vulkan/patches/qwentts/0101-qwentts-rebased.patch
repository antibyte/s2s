diff --git a/CMakeLists.txt b/CMakeLists.txt
index df33706..08e9ea0 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -113,7 +113,18 @@ macro(link_ggml_backends target)
 
     # SYCL links its runtime PRIVATE, consumers need -fsycl to resolve libsycl.so
     if(TARGET ggml-sycl AND GGML_SYCL)
+        target_compile_definitions(${target} PRIVATE QWEN_HAS_SYCL_SAMPLER=1)
         target_link_options(${target} PRIVATE -fsycl)
+        # ggml-sycl is a static library. Its PRIVATE IntelSYCL dependency is not
+        # propagated to final executables on Windows, so explicitly retain
+        # sycl8.lib and the matching compiler/link flags at the consuming target.
+        if(TARGET IntelSYCL::SYCL_CXX)
+            target_link_libraries(${target} PRIVATE IntelSYCL::SYCL_CXX)
+        elseif(WIN32 AND SYCL_LIBRARY)
+            # IntelSYCL::SYCL_CXX is directory-scoped in oneAPI 2025.1 and is
+            # therefore not visible from this parent CMakeLists.
+            target_link_libraries(${target} PRIVATE "${SYCL_LIBRARY}")
+        endif()
     endif()
     add_dependencies(${target} version)
 endmacro()
