diff --git a/include/ggml-sycl.h b/include/ggml-sycl.h
index 5ce349a8..c9a3ffb9 100644
--- a/include/ggml-sycl.h
+++ b/include/ggml-sycl.h
@@ -21,6 +21,21 @@ GGML_BACKEND_API ggml_backend_t ggml_backend_sycl_init(int device);
 
 GGML_BACKEND_API bool ggml_backend_is_sycl(ggml_backend_t backend);
 
+// Qwen CodePredictor helper: sample one contiguous F32 logits row on
+// the active SYCL queue. top_k must be 1..256. The selected token is
+// written into the optional next graph input and a device token array.
+GGML_BACKEND_API bool ggml_backend_sycl_sample_top_k_p(
+        ggml_backend_t backend,
+        const struct ggml_tensor * logits,
+        float temperature,
+        int top_k,
+        float top_p,
+        int64_t seed,
+        int64_t subsequence,
+        struct ggml_tensor * next_token,
+        struct ggml_tensor * sampled_tokens,
+        int sampled_index);
+
 // devide buffer
 GGML_BACKEND_API ggml_backend_buffer_type_t ggml_backend_sycl_buffer_type(int device);
 
diff --git a/src/ggml-sycl/ggml-sycl.cpp b/src/ggml-sycl/ggml-sycl.cpp
index bb9d3ea0..2191cdbd 100644
--- a/src/ggml-sycl/ggml-sycl.cpp
+++ b/src/ggml-sycl/ggml-sycl.cpp
@@ -5312,6 +5312,143 @@ bool ggml_backend_is_sycl(ggml_backend_t backend) {
     return backend != NULL && ggml_guid_matches(backend->guid, ggml_backend_sycl_guid());
 }
 
+bool ggml_backend_sycl_sample_top_k_p(
+        ggml_backend_t backend,
+        const struct ggml_tensor * logits,
+        float temperature,
+        int top_k,
+        float top_p,
+        int64_t seed,
+        int64_t subsequence,
+        struct ggml_tensor * next_token,
+        struct ggml_tensor * sampled_tokens,
+        int sampled_index) try {
+    if (!ggml_backend_is_sycl(backend) || logits == nullptr || sampled_tokens == nullptr ||
+        logits->type != GGML_TYPE_F32 || !ggml_is_contiguous(logits) ||
+        ggml_nrows(logits) != 1 || sampled_tokens->type != GGML_TYPE_I32 ||
+        sampled_index < 0 || sampled_index >= sampled_tokens->ne[0] ||
+        (next_token != nullptr && (next_token->type != GGML_TYPE_I32 || next_token->ne[0] < 1)) ||
+        top_k < 1 || top_k > 256) {
+        return false;
+    }
+    const int n_vocab = (int) logits->ne[0];
+    if (n_vocab < 1) {
+        return false;
+    }
+    const int k = std::min(top_k, n_vocab);
+    auto * ctx = static_cast<ggml_backend_sycl_context *>(backend->context);
+    queue_ptr queue = ctx->stream();
+    ggml_sycl_set_device(ctx->device);
+
+    const float * values = static_cast<const float *>(logits->data);
+    int32_t * next_value = next_token ? static_cast<int32_t *>(next_token->data) : nullptr;
+    int32_t * code_value = static_cast<int32_t *>(sampled_tokens->data) + sampled_index;
+    queue->single_task([=]() {
+        float   selected_values[256];
+        int32_t selected_ids[256];
+        for (int i = 0; i < k; ++i) {
+            selected_values[i] = -INFINITY;
+            selected_ids[i] = -1;
+        }
+
+        const float inv_temperature = temperature > 0.0f ? 1.0f / temperature : 1.0f;
+        for (int token = 0; token < n_vocab; ++token) {
+            const float value = values[token] * inv_temperature;
+            int insert = k;
+            for (int i = 0; i < k; ++i) {
+                if (value > selected_values[i]) {
+                    insert = i;
+                    break;
+                }
+            }
+            if (insert < k) {
+                for (int i = k - 1; i > insert; --i) {
+                    selected_values[i] = selected_values[i - 1];
+                    selected_ids[i] = selected_ids[i - 1];
+                }
+                selected_values[insert] = value;
+                selected_ids[insert] = token;
+            }
+        }
+
+        if (temperature <= 0.0f) {
+            *code_value = selected_ids[0];
+            if (next_value) {
+                *next_value = selected_ids[0];
+            }
+            return;
+        }
+
+        const float max_value = selected_values[0];
+        float probabilities[256];
+        float sum = 0.0f;
+        for (int i = 0; i < k; ++i) {
+            probabilities[i] = sycl::exp(selected_values[i] - max_value);
+            sum += probabilities[i];
+        }
+
+        int keep = k;
+        if (top_p > 0.0f && top_p < 1.0f && sum > 0.0f) {
+            float cumulative = 0.0f;
+            keep = 0;
+            while (keep < k) {
+                cumulative += probabilities[keep] / sum;
+                ++keep;
+                if (cumulative >= top_p) {
+                    break;
+                }
+            }
+            sum = 0.0f;
+            for (int i = 0; i < keep; ++i) {
+                sum += probabilities[i];
+            }
+        }
+
+        uint32_t x = 0u;
+        uint32_t y = 0u;
+        uint32_t z = (uint32_t) (uint64_t) subsequence;
+        uint32_t w = (uint32_t) ((uint64_t) subsequence >> 32);
+        uint32_t key0 = (uint32_t) (uint64_t) seed;
+        uint32_t key1 = (uint32_t) ((uint64_t) seed >> 32);
+        for (int round = 0; round < 10; ++round) {
+            const uint64_t product0 = (uint64_t) 0xD2511F53u * (uint64_t) x;
+            const uint64_t product1 = (uint64_t) 0xCD9E8D57u * (uint64_t) z;
+            const uint32_t next_x = (uint32_t) (product1 >> 32) ^ y ^ key0;
+            const uint32_t next_y = (uint32_t) product1;
+            const uint32_t next_z = (uint32_t) (product0 >> 32) ^ w ^ key1;
+            const uint32_t next_w = (uint32_t) product0;
+            x = next_x;
+            y = next_y;
+            z = next_z;
+            w = next_w;
+            key0 += 0x9E3779B9u;
+            key1 += 0xBB67AE85u;
+        }
+        const float uniform = ((float) x + 0.5f) * 2.3283064365386963e-10f;
+        const float draw = uniform * sum;
+        float cumulative = 0.0f;
+        for (int i = 0; i < keep; ++i) {
+            cumulative += probabilities[i];
+            if (cumulative >= draw) {
+                *code_value = selected_ids[i];
+                if (next_value) {
+                    *next_value = selected_ids[i];
+                }
+                return;
+            }
+        }
+        *code_value = selected_ids[keep - 1];
+        if (next_value) {
+            *next_value = selected_ids[keep - 1];
+        }
+    }).wait();
+    return true;
+}
+catch (const sycl::exception & exc) {
+    GGML_LOG_ERROR("%s: SYCL sampler failed: %s\n", __func__, exc.what());
+    return false;
+}
+
 int ggml_backend_sycl_get_device_count() {
     return ggml_sycl_info().device_count;
 }
