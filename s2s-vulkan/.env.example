# ── Image (GHCR) ─────────────────────────────────────────────────────
# Set GHCR_OWNER to your GitHub user/org (lowercase).
GHCR_OWNER=your-github-user
IMAGE=ghcr.io/your-github-user/s2s-vulkan
TAG=latest

# ── Runtime ──────────────────────────────────────────────────────────
# 127.0.0.1 = local only; 0.0.0.0 = reachable on the LAN
S2S_BIND_HOST=0.0.0.0
# Compose always runs the controller in lab mode on its private port 8765.
# Only the web port below is published to the host.
S2S_GPU=auto
# GGML_BACKEND=Vulkan0
RUST_LOG=info

# ── 8 GB GPU budget (default lab stack) ──────────────────────────────
# Target concurrent footprint (approx, order of magnitude):
#
#   Component              Role              VRAM (GPU)
#   --------------------   ---------------   -----------------
#   llama.cpp Granite 2B   LLM (Q4_K_M)      ~1.6–2.5 GB  (+ctx 2k)
#   whisper.cpp base       ASR               ~0.2–0.5 GB  (or CPU)
#   Supertonic ONNX        TTS               ~0 GB        (CPU)
#   s2s-vulkan             orchestrator      ~0 GB
#   ─────────────────────────────────────────────────────
#   TOTAL default                           ~2–3.5 GB  → fits 8 GB
#
# Optional Qwen3-TTS 0.6B (profile `tts` / `full`):
#   ~3–4 GB alone. On 8 GB do NOT load Qwen TTS + large Whisper + LLM all on GPU.
#   Prefer: TTS=supertonic (default) for lab; enable Qwen TTS only for quality tests.
#
# Lab start (no Ollama):
#   docker compose --profile backends --profile web up -d --build
#   open http://localhost:8766

# Language: STT hint + TTS (Supertonic / HTTP TTS need a code)
S2S_LANGUAGE=de
S2S_TTS_LANGUAGE=de
# Default TTS keeps GPU free for LLM+ASR
S2S_TTS=http
S2S_TTS_URL=http://supertonic:8083/v1/audio/speech
S2S_SUPERTONIC_VOICE=M1
S2S_QWEN_MAX_NEW_TOKENS=256
S2S_TTS_STREAM_CHUNK_MS=160
S2S_ALLOW_EXPERIMENTAL=false
PARAKEET_TORCH_VERSION=2.11.0
# Idle-unload managed ASR/TTS/LLM containers after last WebSocket disconnect (0 = off).
# Lab default 120s saves RAM/GPU; AuraGo production chat/telephony should use 0.
S2S_LAB_IDLE_UNLOAD_SECS=120
# AuraGo production profile (always-on gateway, stable-first suggestions):
# S2S_LAB_IDLE_UNLOAD_SECS=0
# S2S_ALLOW_EXPERIMENTAL=false
# Optional capability overrides for suggestions when VRAM is not visible in Docker:
# S2S_CAPABILITY_VRAM_TOTAL_GB=12
# S2S_CAPABILITY_TIER=host-vulkan
# Windows Docker Desktop cannot enumerate an Intel Arc GPU from its Linux VM.
# The Windows compose overlay shares these directories with the native host agent.
# S2S_MODELS_HOST_DIR=D:\s2s\models
# S2S_DATA_HOST_DIR=D:\s2s\data
# Enable only while validating experimental variants:
# S2S_ALLOW_EXPERIMENTAL=true
# Windows overlay-specific hardware inputs. Their distinct names prevent stale
# Linux/SYCL values in S2S_LAB_* from overriding the native Vulkan path.
# S2S_WINDOWS_LAB_GPU_VENDOR=intel
# S2S_WINDOWS_LAB_DEVICE_NAME=Intel Arc B580
# S2S_WINDOWS_LAB_ACCELERATORS=vulkan,sycl,cpu
# Optional executable overrides for scripts/host_idle_agent.ps1:
# S2S_HOST_CRISPASR_EXE=D:\tools\CrispASR\build-vulkan\bin\crispasr.exe
# S2S_HOST_LLAMA_EXE=D:\tools\llama.cpp\build\bin\Release\llama-server.exe
# S2S_HOST_QWEN_SYCL_EXE=D:\tools\qwentts\build-sycl\bin\Release\tts-server.exe
# S2S_HOST_SUPERTONIC_EXE=D:\repo\s2s\s2s-vulkan\target\release\s2s-vulkan.exe
# S2S_HOST_CHATTERBOX_PYTHON=D:\repo\s2s\s2s-vulkan\tools\chatterbox\.venv\Scripts\python.exe
# S2S_HOST_XTTS_PYTHON=D:\repo\s2s\s2s-vulkan\tools\xtts-v2\.venv\Scripts\python.exe
# S2S_HOST_INFLECT_PYTHON=D:\repo\s2s\s2s-vulkan\tools\inflect\.venv\Scripts\python.exe
# S2S_INFLECT_MODEL_DIR=D:\repo\s2s\s2s-vulkan\models\inflect-micro-v2
# S2S_INFLECT_DEVICE=cpu
# S2S_HOST_AUDIO8_PYTHON=D:\repo\s2s\s2s-vulkan\tools\audio8\.venv\Scripts\python.exe
# S2S_AUDIO8_MODEL_DIR=D:\repo\s2s\s2s-vulkan\models\audio8-tts-preview-0.6b
# S2S_AUDIO8_DEVICE=cpu
# S2S_ONEAPI_ROOT=D:\Intel\oneAPI
# Supertonic is already bundled under /opt/s2s-models/supertonic/onnx.
S2S_MAX_TOKENS=128
S2S_SYSTEM_PROMPT=Du bist ein hilfreicher Sprachassistent. Antworte immer auf Deutsch, kurz und gesprächig (1-3 Sätze).

# ── First-boot model download ────────────────────────────────────────
S2S_DOWNLOAD_MODELS=false
S2S_DOWNLOAD_FORCE=0
S2S_DOWNLOAD_WHISPER=false
S2S_DOWNLOAD_LLM=false
S2S_DOWNLOAD_TTS=false

# faster-whisper tiny is bundled; larger models are installed by the Lab UI.
S2S_WHISPER_PRESET=tiny
# S2S_WHISPER_HF_FILE=ggml-base.bin
# S2S_WHISPER_MODEL_URL=https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base.bin

# Granite 3.3 2B is bundled and selected initially. An external endpoint remains
# available as a later catalog choice with automatic failback/fallback handling.
S2S_LLM_EXTERNAL_URL=http://host.docker.internal:11434/v1
S2S_LLM_EXTERNAL_MODEL=qwen3.5:cloud

# Bundled LLM inside the dedicated llama.cpp image
# https://huggingface.co/Edge-Quant/granite-3.3-2b-instruct-Q4_K_M-GGUF
S2S_LLM_HF_REPO=Edge-Quant/granite-3.3-2b-instruct-Q4_K_M-GGUF
S2S_LLM_HF_FILE=granite-3.3-2b-instruct-q4_k_m.gguf
S2S_LLM_MODEL=granite-3.3-2b-instruct
# HF_TOKEN=hf_xxx   # server-side only; required for gated XTTS-v2 artifacts

# Keep KV small on 8 GB cards
LLAMA_CTX=2048
LLAMA_NGL=99

# ── Host GIDs for /dev/dri (Linux) ───────────────────────────────────
VIDEO_GID=44
RENDER_GID=109

# Intel B580 AOT image:
# QWEN_SYCL_DEVICE_ARCH=bmg_g21
# TTS_IMAGE=s2s-tts-qwen-sycl:b580
# QWEN_CODE_SAMPLER=host

# ── Optional backend URLs if not using compose profiles ──────────────
# S2S_WHISPER_URL=http://host.docker.internal:8082
# S2S_LLM_URL=http://host.docker.internal:8081/v1
# S2S_TTS_URL=http://host.docker.internal:8083/v1/audio/speech
# Higgs TTS 3 4B (profile higgs / managed; needs large NVIDIA VRAM):
# HIGGS_PORT=8086
# HIGGS_IMAGE=s2s-tts-higgs:local
# S2S_TTS_URL=http://host.docker.internal:8086/v1/audio/speech
# S2S_TTS_MODEL=bosonai/higgs-tts-3-4b
# Voxtral Mini 4B Realtime ASR (profile voxtral / managed; ~16 GB NVIDIA):
# VOXTRAL_PORT=8087
# S2S_WHISPER_URL=http://host.docker.internal:8087
# VibeVoice Realtime 0.5B TTS (profile vibevoice / managed; CrispASR GGUF):
# VIBEVOICE_PORT=8089
# S2S_TTS_URL=http://host.docker.internal:8089/v1/audio/speech
# S2S_TTS_MODEL=vibevoice-realtime-0.5b
# Chatterbox Multilingual V3 (experimental Windows host profile; CPU or CUDA):
# CHATTERBOX_PORT=8090
# S2S_TTS_URL=http://host.docker.internal:8090/v1/audio/speech
# S2S_TTS_MODEL=ResembleAI/chatterbox
# XTTS-v2 ONNX (experimental Windows host profile; WebGPU/Vulkan or CPU):
# XTTS_PORT=8091
# S2S_TTS_URL=http://host.docker.internal:8091/v1/audio/speech
# S2S_TTS_MODEL=coqui/XTTS-v2
# Audio8 TTS Preview 0.6B (experimental Windows host profile; CUDA preferred):
# AUDIO8_PORT=8096
# S2S_TTS_URL=http://host.docker.internal:8096/v1/audio/speech
# S2S_TTS_MODEL=Audio8/Audio8-TTS-Preview-0.6b
# After the last WebSocket client disconnects, stop managed ASR/TTS/LLM containers
# (all catalog sidecars, including host-variant siblings) to free GPU/RAM.
# Default 120s; set 0 to disable.
# S2S_LAB_IDLE_UNLOAD_SECS=120
# Run the allowlisted Windows host supervisor while using the lab. It stops only
# child PIDs it started and also accepts the legacy idle request files:
#   .\scripts\host_idle_agent.ps1

# ── Web test UI (profile: web) ───────────────────────────────────────
# docker compose --profile backends --profile web up -d --build
WEB_PORT=8766
