# Mistral Voxtral Mini 4B Realtime — Transformers HTTP ASR sidecar.
# Weights: /models/voxtral-mini-4b-realtime (Lab download or hf download).

FROM python:3.12-slim-bookworm

ARG TORCH_VERSION=2.11.0
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    VOXTRAL_MODEL_DIR=/models/voxtral-mini-4b-realtime \
    VOXTRAL_DEVICE=auto \
    VOXTRAL_DTYPE=auto

RUN apt-get update \
    && apt-get install -y --no-install-recommends libsndfile1 ffmpeg \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install \
      --index-url "${TORCH_INDEX_URL}" \
      "torch==${TORCH_VERSION}" \
      "torchaudio==${TORCH_VERSION}" \
    && python -m pip install \
      "aiohttp==3.14.3" \
      "librosa==0.11.0" \
      "numpy==2.4.2" \
      "soundfile==0.14.0" \
      "soxr==0.5.0.post1" \
      "transformers>=5.2.0" \
      "mistral-common[audio]>=1.9.0"

WORKDIR /app
COPY scripts/voxtral_asr_server.py /app/voxtral_asr_server.py

EXPOSE 8082
CMD ["python", "-u", "/app/voxtral_asr_server.py"]
