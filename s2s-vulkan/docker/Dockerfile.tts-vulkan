# syntax=docker/dockerfile:1.7
# Native Qwen3-TTS server for the managed 0.6B Vulkan variant.
FROM ubuntu:24.04 AS builder

ARG QWENTTS_REV=82cd05b9f3a175612dc89fd6943e610fab096ef5
ARG GGML_REV=c044c6f03892f9d5e98213b05f8afea1f8b0d3c9
ARG BUILD_JOBS=4

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates git cmake ninja-build build-essential libvulkan-dev \
        glslc glslang-tools spirv-headers spirv-tools \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
RUN git clone --filter=blob:none https://github.com/ServeurpersoCom/qwentts.cpp.git /src/qwentts.cpp \
    && git -C /src/qwentts.cpp checkout --detach "${QWENTTS_REV}" \
    && git -C /src/qwentts.cpp submodule update --init ggml \
    && git -C /src/qwentts.cpp/ggml checkout --detach "${GGML_REV}"

RUN cmake -S /src/qwentts.cpp -B /src/qwentts.cpp/build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release -DGGML_VULKAN=ON -DGGML_SYCL=OFF \
        -DGGML_NATIVE=OFF -DGGML_BACKEND_DL=OFF -DBUILD_SHARED_LIBS=OFF \
    && cmake --build /src/qwentts.cpp/build --target tts-server -j"${BUILD_JOBS}" \
    && /src/qwentts.cpp/build/tts-server --help

FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl tini libvulkan1 mesa-vulkan-drivers libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /src/qwentts.cpp/build/tts-server /usr/local/bin/tts-server

ENV GGML_BACKEND=Vulkan0 QWEN_CODE_SAMPLER=host S2S_MODELS_DIR=/models
EXPOSE 8083
HEALTHCHECK --interval=10s --timeout=5s --start-period=120s --retries=12 \
    CMD curl -fsS http://127.0.0.1:8083/health || exit 1
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["bash", "-lc", "exec tts-server \
    --model ${QWEN_TALKER:-/models/qwen/qwen-talker-0.6b-customvoice-Q4_K_M.gguf} \
    --codec ${QWEN_CODEC:-/models/qwen/qwen-tokenizer-12hz-Q8_0.gguf} \
    --alias qwen3-tts-vulkan --host 0.0.0.0 --port 8083 \
    --lang german --clamp-fp16"]
