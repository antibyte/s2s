# syntax=docker/dockerfile:1.7
ARG GATEWAY_IMAGE=s2s-vulkan:local
FROM ${GATEWAY_IMAGE} AS gateway

# Python is used only to verify/unpack the release assets during the build.
FROM python:3.12-slim-bookworm AS resources
WORKDIR /src
COPY scripts/prepare_phonon.py scripts/prepare_phonon.py
COPY config/phonon.json config/phonon.json
COPY deploy/phonon/ /packages/
RUN python scripts/prepare_phonon.py --packages /packages --output /resources

FROM ubuntu:24.04
LABEL org.opencontainers.image.source="https://github.com/antibyte/s2s" \
      org.opencontainers.image.title="Speech Lab Phonon 40M multilingual" \
      org.opencontainers.image.licenses="Apache-2.0 AND MIT AND CC-BY-NC-4.0" \
      s2s.lab.bundled-model="0.4.0-1537ce46c64f-0ee17205f254"
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl libasound2t64 libgomp1 tini \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -m -u 10001 -s /usr/sbin/nologin s2s
COPY --from=gateway /usr/local/bin/s2s-vulkan /usr/local/bin/s2s-vulkan
COPY --from=resources /resources /opt/s2s-models/phonon
ENV HF_HUB_OFFLINE=1 S2S_DOCKER=1 RUST_LOG=info
USER s2s
EXPOSE 8083
HEALTHCHECK --interval=5s --timeout=5s --start-period=30s \
    CMD curl -fsS http://127.0.0.1:8083/health || exit 1
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/s2s-vulkan"]
CMD ["--mode", "phonon-tts-server", "--host", "0.0.0.0", "--port", "8083", "--gpu", "cpu", "--skip-health"]
